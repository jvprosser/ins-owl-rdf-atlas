@prefix ex: <https://example.org/ins/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:label "Car insurance claims Minimal Viable TBox" ;
    rdfs:comment "Phase 1 spine classes and properties for in-memory claim-run graphs." .

# --- Classes ---
ex:AutoClaim a owl:Class ; rdfs:label "Auto Claim" .
ex:LossEvent a owl:Class ; rdfs:label "Loss Event" .
ex:AutoInsurancePolicy a owl:Class ; rdfs:label "Auto Insurance Policy" .
ex:PolicyCoverage a owl:Class ; rdfs:label "Policy Coverage" .
ex:Coverage a owl:Class ; rdfs:label "Coverage" .
ex:Vehicle a owl:Class ; rdfs:label "Vehicle" .
ex:Party a owl:Class ; rdfs:label "Party" .
ex:Person a owl:Class ; rdfs:subClassOf ex:Party .
ex:Organization a owl:Class ; rdfs:subClassOf ex:Party .
ex:ClaimPartyRole a owl:Class ; rdfs:label "Claim Party Role" .
ex:ClaimLifecycle a owl:Class ; rdfs:label "Claim Lifecycle" .
ex:ClaimInjury a owl:Class ; rdfs:label "Claim Injury" .
ex:SubrogationCase a owl:Class ; rdfs:label "Subrogation Case" .
ex:LitigationCase a owl:Class ; rdfs:label "Litigation Case" .
ex:ClaimOffer a owl:Class ; rdfs:label "Claim Offer" .
ex:ClaimReserve a owl:Class ; rdfs:label "Claim Reserve" .
ex:FaultDetermination a owl:Class ; rdfs:label "Fault Determination" .
ex:PoliceReport a owl:Class ; rdfs:label "Police Report" .
ex:ClaimDocument a owl:Class ; rdfs:label "Claim Document" .
ex:ClaimPayment a owl:Class ; rdfs:label "Claim Payment" .
ex:ClaimRecovery a owl:Class ; rdfs:label "Claim Recovery" .
ex:FraudAssessment a owl:Class ; rdfs:label "Fraud Assessment" .

# --- Object properties ---
ex:fromLossEvent a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:LossEvent .
ex:arisesFromPolicy a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:AutoInsurancePolicy .
ex:involvesVehicle a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:Vehicle .
ex:underPolicyCoverage a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:PolicyCoverage .
ex:ofCoverageType a owl:ObjectProperty ; rdfs:domain ex:PolicyCoverage ; rdfs:range ex:Coverage .
ex:coversVehicle a owl:ObjectProperty ; rdfs:domain ex:AutoInsurancePolicy ; rdfs:range ex:Vehicle .
ex:hasClaimPartyRole a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimPartyRole .
ex:rolePlayedBy a owl:ObjectProperty ; rdfs:domain ex:ClaimPartyRole ; rdfs:range ex:Party .
ex:hasLifecycle a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimLifecycle .
ex:hasInjury a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimInjury .
ex:hasSubrogationCase a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:SubrogationCase .
ex:hasLitigationCase a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:LitigationCase .
ex:hasOffer a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimOffer .
ex:hasReserve a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimReserve .
ex:hasFaultDetermination a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:FaultDetermination .
ex:hasPoliceReport a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:PoliceReport .
ex:hasDocument a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimDocument .
ex:hasLossPayment a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimPayment .
ex:hasRecovery a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:ClaimRecovery .
ex:hasFraudAssessment a owl:ObjectProperty ; rdfs:domain ex:AutoClaim ; rdfs:range ex:FraudAssessment .

# --- Datatype properties ---
ex:claimNumber a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:claimStatusCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:fraudulentClaimIndicator a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ex:litigationIndicator a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ex:subrogationIndicator a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ex:totalLossIndicator a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ex:lossCauseCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:policyNumber a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:coverageTypeCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:roleTypeCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:offerStatusCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:subrogationStatusCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:fraudOutcomeCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:paymentCategoryCode a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:reserveIsCurrent a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ex:vin a owl:DatatypeProperty ; rdfs:range xsd:string .
