<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_ClaimsPlaybook"
 targetNamespace="http://ins-owl-rdf-atlas/claims">
  <process id="ClaimsPlaybook" name="Claims playbook" isExecutable="false">
    <laneSet id="LaneSet_Claims">
      <lane id="Lane_DATA_QUALITY" name="DATA_QUALITY">
        <flowNodeRef>FixDataQuality</flowNodeRef>
        <flowNodeRef>AssignAdjuster</flowNodeRef>
      </lane>
      <lane id="Lane_PD" name="PD">
        <flowNodeRef>CollectIncidentReportNumber</flowNodeRef>
        <flowNodeRef>WaitForIncidentNumber</flowNodeRef>
        <flowNodeRef>RequestPoliceReport</flowNodeRef>
        <flowNodeRef>DetermineFault</flowNodeRef>
        <flowNodeRef>OpenSubrogationCase</flowNodeRef>
        <flowNodeRef>PursueSubrogationRecovery</flowNodeRef>
        <flowNodeRef>PdClaimsReview</flowNodeRef>
      </lane>
      <lane id="Lane_BI" name="BI">
        <flowNodeRef>CaptureInjuryDetails</flowNodeRef>
        <flowNodeRef>BiClaimsReview</flowNodeRef>
      </lane>
      <lane id="Lane_LITIGATION" name="LITIGATION">
        <flowNodeRef>CompleteLitigationFile</flowNodeRef>
        <flowNodeRef>EscalateDiscovery</flowNodeRef>
        <flowNodeRef>LitigationSupport</flowNodeRef>
      </lane>
      <lane id="Lane_SIU" name="SIU">
        <flowNodeRef>SiuInvestigation</flowNodeRef>
      </lane>
      <lane id="Lane_DENY" name="DENY">
        <flowNodeRef>DenyAudit</flowNodeRef>
        <flowNodeRef>DenyUnlawfulOperation</flowNodeRef>
        <flowNodeRef>DenyExcludedDriver</flowNodeRef>
        <flowNodeRef>DenyLapsedPolicy</flowNodeRef>
      </lane>
      <lane id="Lane_CLOSEOUT" name="CLOSEOUT">
        <flowNodeRef>CloseoutAudit</flowNodeRef>
      </lane>
      <lane id="Lane_GENERAL" name="GENERAL">
        <flowNodeRef>HumanCitationReview</flowNodeRef>
        <flowNodeRef>FollowUpOffer</flowNodeRef>
        <flowNodeRef>IssuePayment</flowNodeRef>
        <flowNodeRef>HumanReviewOrWait</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="RecieveFNOLSubmission" name="RecieveFNOLSubmission"/>
    <exclusiveGateway id="Gateway_Route" name="Route" default="Flow_Branch_HumanReviewOrWait"/>
    <userTask id="FixDataQuality" name="FixDataQuality"/>
    <userTask id="CloseoutAudit" name="CloseoutAudit"/>
    <userTask id="DenyAudit" name="DenyAudit"/>
    <userTask id="HumanCitationReview" name="HumanCitationReview"/>
    <userTask id="DenyUnlawfulOperation" name="DenyUnlawfulOperation"/>
    <userTask id="DenyExcludedDriver" name="DenyExcludedDriver"/>
    <userTask id="DenyLapsedPolicy" name="DenyLapsedPolicy"/>
    <userTask id="CompleteLitigationFile" name="CompleteLitigationFile"/>
    <userTask id="EscalateDiscovery" name="EscalateDiscovery"/>
    <userTask id="LitigationSupport" name="LitigationSupport"/>
    <userTask id="SiuInvestigation" name="SiuInvestigation"/>
    <userTask id="AssignAdjuster" name="AssignAdjuster"/>
    <userTask id="CollectIncidentReportNumber" name="CollectIncidentReportNumber"/>
    <userTask id="WaitForIncidentNumber" name="WaitForIncidentNumber"/>
    <userTask id="RequestPoliceReport" name="RequestPoliceReport"/>
    <userTask id="DetermineFault" name="DetermineFault"/>
    <userTask id="CaptureInjuryDetails" name="CaptureInjuryDetails"/>
    <userTask id="FollowUpOffer" name="FollowUpOffer"/>
    <userTask id="IssuePayment" name="IssuePayment"/>
    <userTask id="OpenSubrogationCase" name="OpenSubrogationCase"/>
    <userTask id="PursueSubrogationRecovery" name="PursueSubrogationRecovery"/>
    <userTask id="BiClaimsReview" name="BiClaimsReview"/>
    <userTask id="PdClaimsReview" name="PdClaimsReview"/>
    <userTask id="HumanReviewOrWait" name="HumanReviewOrWait"/>
    <endEvent id="End" name="End"/>
    <sequenceFlow id="Flow_RecieveFNOLSubmission" sourceRef="RecieveFNOLSubmission" targetRef="CollectIncidentReportNumber"/>
    <sequenceFlow id="Flow_ToRoute" sourceRef="RecieveFNOLSubmission" targetRef="Gateway_Route"/>
    <sequenceFlow id="Flow_CollectIncidentReportNumber" sourceRef="CollectIncidentReportNumber" targetRef="WaitForIncidentNumber"/>
    <sequenceFlow id="Flow_WaitForIncidentNumber" sourceRef="WaitForIncidentNumber" targetRef="RequestPoliceReport"/>
    <sequenceFlow id="Flow_RequestPoliceReport" sourceRef="RequestPoliceReport" targetRef="DetermineFault"/>
    <sequenceFlow id="Flow_DetermineFault" sourceRef="DetermineFault" targetRef="PdClaimsReview"/>
    <sequenceFlow id="Flow_Branch_FixDataQuality" name="FixDataQuality" sourceRef="Gateway_Route" targetRef="FixDataQuality"/>
    <sequenceFlow id="Flow_Branch_CloseoutAudit" name="CloseoutAudit" sourceRef="Gateway_Route" targetRef="CloseoutAudit"/>
    <sequenceFlow id="Flow_Branch_DenyAudit" name="DenyAudit" sourceRef="Gateway_Route" targetRef="DenyAudit"/>
    <sequenceFlow id="Flow_Branch_HumanCitationReview" name="HumanCitationReview" sourceRef="Gateway_Route" targetRef="HumanCitationReview"/>
    <sequenceFlow id="Flow_Branch_DenyUnlawfulOperation" name="DenyUnlawfulOperation" sourceRef="Gateway_Route" targetRef="DenyUnlawfulOperation"/>
    <sequenceFlow id="Flow_Branch_DenyExcludedDriver" name="DenyExcludedDriver" sourceRef="Gateway_Route" targetRef="DenyExcludedDriver"/>
    <sequenceFlow id="Flow_Branch_DenyLapsedPolicy" name="DenyLapsedPolicy" sourceRef="Gateway_Route" targetRef="DenyLapsedPolicy"/>
    <sequenceFlow id="Flow_Branch_CompleteLitigationFile" name="CompleteLitigationFile" sourceRef="Gateway_Route" targetRef="CompleteLitigationFile"/>
    <sequenceFlow id="Flow_Branch_EscalateDiscovery" name="EscalateDiscovery" sourceRef="Gateway_Route" targetRef="EscalateDiscovery"/>
    <sequenceFlow id="Flow_Branch_LitigationSupport" name="LitigationSupport" sourceRef="Gateway_Route" targetRef="LitigationSupport"/>
    <sequenceFlow id="Flow_Branch_SiuInvestigation" name="SiuInvestigation" sourceRef="Gateway_Route" targetRef="SiuInvestigation"/>
    <sequenceFlow id="Flow_Branch_AssignAdjuster" name="AssignAdjuster" sourceRef="Gateway_Route" targetRef="AssignAdjuster"/>
    <sequenceFlow id="Flow_Branch_CaptureInjuryDetails" name="CaptureInjuryDetails" sourceRef="Gateway_Route" targetRef="CaptureInjuryDetails"/>
    <sequenceFlow id="Flow_Branch_FollowUpOffer" name="FollowUpOffer" sourceRef="Gateway_Route" targetRef="FollowUpOffer"/>
    <sequenceFlow id="Flow_Branch_IssuePayment" name="IssuePayment" sourceRef="Gateway_Route" targetRef="IssuePayment"/>
    <sequenceFlow id="Flow_Branch_OpenSubrogationCase" name="OpenSubrogationCase" sourceRef="Gateway_Route" targetRef="OpenSubrogationCase"/>
    <sequenceFlow id="Flow_Branch_PursueSubrogationRecovery" name="PursueSubrogationRecovery" sourceRef="Gateway_Route" targetRef="PursueSubrogationRecovery"/>
    <sequenceFlow id="Flow_Branch_BiClaimsReview" name="BiClaimsReview" sourceRef="Gateway_Route" targetRef="BiClaimsReview"/>
    <sequenceFlow id="Flow_Branch_HumanReviewOrWait" name="HumanReviewOrWait" sourceRef="Gateway_Route" targetRef="HumanReviewOrWait"/>
    <sequenceFlow id="Flow_End_CloseoutAudit" sourceRef="CloseoutAudit" targetRef="End"/>
    <sequenceFlow id="Flow_End_DenyAudit" sourceRef="DenyAudit" targetRef="End"/>
    <sequenceFlow id="Flow_End_DenyExcludedDriver" sourceRef="DenyExcludedDriver" targetRef="End"/>
    <sequenceFlow id="Flow_End_DenyLapsedPolicy" sourceRef="DenyLapsedPolicy" targetRef="End"/>
    <sequenceFlow id="Flow_End_DenyUnlawfulOperation" sourceRef="DenyUnlawfulOperation" targetRef="End"/>
    <sequenceFlow id="Flow_End_HumanCitationReview" sourceRef="HumanCitationReview" targetRef="End"/>
    <sequenceFlow id="Flow_End_HumanReviewOrWait" sourceRef="HumanReviewOrWait" targetRef="End"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_ClaimsPlaybook">
    <bpmndi:BPMNPlane bpmnElement="ClaimsPlaybook">
      <bpmndi:BPMNShape bpmnElement="RecieveFNOLSubmission" id="Shape_RecieveFNOLSubmission">
        <dc:Bounds x="330" y="166" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Gateway_Route" id="Shape_Gateway_Route">
