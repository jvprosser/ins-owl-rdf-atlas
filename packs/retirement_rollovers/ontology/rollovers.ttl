@prefix ex: <https://example.org/ins/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:label "Retirement rollover request TBox" ;
    rdfs:comment "Minimal TBox for deterministic ERISA / rollover routing (demo pack)." .

ex:RolloverRequest a owl:Class ; rdfs:label "Rollover Request" .

ex:requestStatusCode a owl:DatatypeProperty ; rdfs:domain ex:RolloverRequest ; rdfs:range xsd:string .
ex:rolloverTypeCode a owl:DatatypeProperty ; rdfs:domain ex:RolloverRequest ; rdfs:range xsd:string .
ex:planId a owl:DatatypeProperty ; rdfs:domain ex:RolloverRequest ; rdfs:range xsd:string .
ex:participantId a owl:DatatypeProperty ; rdfs:domain ex:RolloverRequest ; rdfs:range xsd:string .
ex:missingSpousalConsent a owl:DatatypeProperty ; rdfs:domain ex:RolloverRequest ; rdfs:range xsd:boolean .
ex:missingRequiredDocs a owl:DatatypeProperty ; rdfs:domain ex:RolloverRequest ; rdfs:range xsd:boolean .
