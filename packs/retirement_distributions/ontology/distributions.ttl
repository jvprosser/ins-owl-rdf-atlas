@prefix ex: <https://example.org/ins/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:label "Retirement distribution request TBox" ;
    rdfs:comment "Minimal TBox for deterministic distribution routing (demo pack)." .

ex:DistributionRequest a owl:Class ; rdfs:label "Distribution Request" .

ex:requestStatusCode a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:string .
ex:distributionTypeCode a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:string .
ex:planId a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:string .
ex:participantId a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:string .
ex:hardshipSubstantiationMissing a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:boolean .
ex:holdOrAmlFlag a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:boolean .
ex:rmdUnderpaid a owl:DatatypeProperty ; rdfs:domain ex:DistributionRequest ; rdfs:range xsd:boolean .
