{
  "id": "claims",
  "label": "Car insurance claims case JSON",
  "comment": "Field names on the session case document (spine + signals). RDF/SPARQL restore: git checkout rdf-sparql-runtime.",
  "case_class": "AutoClaim",
  "fields": {
    "claim_id": { "type": "string" },
    "claim_exists": { "type": "boolean" },
    "claim_status_code": { "type": "string" },
    "litigation_indicator": { "type": "boolean" },
    "has_litigation_case": { "type": "boolean" },
    "docket_number": { "type": "string" },
    "defense_counsel_party_id": { "type": "string", "comment": "empty when neither counsel id is on the litigation row" },
    "plaintiff_counsel_party_id": { "type": "string" },
    "filed_date": { "type": "string", "comment": "ISO date; playbook CEL uses eval_date + 90 days for discovery aging" },
    "closed_date": { "type": "string" },
    "litigation_status_code": { "type": "string" },
    "eval_date": { "type": "string", "comment": "host YYYY-MM-DD injected by flatten_case (celpy has no now())" },
    "subrogation_indicator": { "type": "boolean" },
    "policy_id": { "type": "string" },
    "insurable_object_id": { "type": "string" },
    "policy_covers_vehicle": { "type": "boolean" },
    "triangle": { "type": "boolean", "comment": "policy + vehicle + covers" },
    "coverage_type_codes": { "type": "string[]" },
    "has_adjuster": { "type": "boolean" },
    "has_incident_report_number": { "type": "boolean", "comment": "policyholder supplied agency incident report number" },
    "incident_report_number": { "type": "string", "comment": "agency incident / exchange-slip number from claim_police_intake" },
    "has_police_report": { "type": "boolean" },
    "has_fault_determination": { "type": "boolean" },
    "has_injury": { "type": "boolean" },
    "has_extended_offer": { "type": "boolean" },
    "has_accepted_offer": { "type": "boolean" },
    "has_loss_payment": { "type": "boolean" },
    "has_recovery": { "type": "boolean" },
    "has_subrogation_case": { "type": "boolean" },
    "subrogation_status_code": { "type": "string" },
    "has_siu_suspected": { "type": "boolean" },
    "loss_date": { "type": "string", "comment": "ISO date from loss_event" },
    "policy_status_code": { "type": "string" },
    "effective_date": { "type": "string" },
    "expiration_date": { "type": "string" },
    "cancellation_date": { "type": "string" },
    "insured_operators": {
      "type": "object[]",
      "comment": "INSURED_OPERATOR rows: was_cited_indicator, impairment_suspected_indicator, license_status_code, on_policy, is_excluded_driver"
    }
  }
}
